{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "path": "../libmpvnative/cpp/CMakeLists.txt",
      "arguments": "",
      "abiFilters": [
        "arm64-v8a"
      ]
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      // 打包时候排除x64 so包，减少包体积
      "nativeLib": {
        "filter": {
          "excludes": [
            "**/x86_64/*.so"
          ]
        }
      },
      // 这里开启了纹理压缩，用于提升内置图片加载速度
      "resOptions": {
        "compression": {
          "media": {
            "enable": true
          },
          "filters": [
            {
              "method": {
                "type": "sut",
                // conversion type
                "blocks": "4x4"
                // The extended parameters of the conversion type
              },
              // Specifies the files used for compression. Only files that meet all conditions and are not excluded can be compressed
              "files": {
                "path": [
                  "./**/*"
                ],
                "size": [
                  [
                    0,
                    '1000k'
                  ]
                ],
                "resolution": [
                  [
                    {
                      "width": 0,
                      "height": 0
                    },
                    {
                      "width": 3000,
                      "height": 3000
                    }
                  ]
                ]
              },
              "exclude": {
                "path": [
                  "./**/layered_image.json",
                  "./**/Foreground.png",
                  "./**/Background.png",
                  "./**/foreground_start_up.png",
                ]
              }
            }
          ]
        }
      },
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    },
  ],
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "ohosTest",
    }
  ]
}